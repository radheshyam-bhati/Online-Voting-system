# Database
DATABASE_URL="postgresql://user:password@localhost:5432/votara?schema=public"

# Auth
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Seed Admin (optional - for custom admin credentials)
# SEED_ADMIN_EMAIL="your-real-email@college.edu"
# SEED_ADMIN_PASSWORD="your-secure-password"
# SEED_ADMIN_NAME="Your Name"
# SEED_ADMIN_ENROLLMENT="YOUR_ENROLLMENT"

# Seed Test Students (optional - only for development/testing)
# SEED_TEST_STUDENTS="true"

# Vercel Blob (for file uploads)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Optional: Email (for notifications)
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT=""
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
